{
  "applicationId": "com.baojiayi.app",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/dist/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": true,
    "writeToLogFile": true
  },
  "nativeAllowList": [
    "app.*",
    "os.*",
    "filesystem.*",
    "storage.*",
    "debug.log",
    "window.*",
    "events.*",
    "clipboard.*",
    "computer.*",
    "extensions.*"
  ],
  "modes": {
    "window": {
      "title": "报价易 - 专业报价单生成器",
      "width": 1280,
      "height": 800,
      "minWidth": 960,
      "minHeight": 600,
      "center": true,
      "icon": "/favicon.png"
    }
  },
  "cli": {
    "binaryName": "baojiayi",
    "resourcesPath": "/dist/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/js/neutralino.js",
    "binaryVersion": "5.4.0",
    "clientVersion": "5.4.0"
  }
}
